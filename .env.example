# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...
DATAMASTER_MODEL=claude-sonnet-5-5

# Any SQLAlchemy URL. Use a READ-ONLY database user for real databases.
DATABASE_URL=sqlite:///data/sample.db
# DATABASE_URL=postgresql+psycopg2://readonly_user:password@host:5432/dbname
# DATABASE_URL=mssql+pyodbc://readonly_user:password@yourserver.database.windows.net:1433/dbname?driver=ODBC+Driver+18+for+SQL+Server

DATAMASTER_MAX_ROWS=200      # rows returned to the UI / sent to the LLM
DATAMASTER_MAX_RETRIES=2     # how many times the LLM may fix a failing query
